# Copy to .env and fill the blanks. Every variable is read by common/config.py (ARCHITECTURE §12).
# Never commit .env. Keep comments on their own lines: Docker Compose reads `KEY=  # x` as the value "# x".

# --- Endpoints -----------------------------------------------------------------------------------
GATEWAY_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://vna:vna@postgres:5432/vna
RABBITMQ_URL=amqp://vna:vna@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0

# --- LLM -----------------------------------------------------------------------------------------
# gemini | ollama | fake
LLM_PROVIDER=gemini
# Gemini key from Google AI Studio
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# From this stage attempt on, a 5xx/timeout on LLM_MODEL retries once on LLM_FALLBACK_MODEL
LLM_FALLBACK_FROM_ATTEMPT=3
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
# unset -> 60000 for gemini, 12000 for ollama/fake
LLM_CHUNK_CHARS=
LLM_MAX_REPAIRS=1
# minimal | low | medium | high (gemini-3.8-flash: low/medium/high only)
LLM_THINKING_LEVEL=low
# Per-request timeout for the LLM call
LLM_TIMEOUT_S=240

# --- Rate limits (set BELOW the real limits shown for your project) ------------------------------
LLM_RPM=4
LLM_TPM=200000
NOTION_RPS=2.5
YOUTUBE_RPM=30
# Bucket capacities (allowed burst); LLM_BURST + LLM_RPM must stay within the real RPM
LLM_BURST=1
NOTION_BURST=3
YOUTUBE_BURST=2
# Per-request timeout for YouTube metadata/transcript/download calls
YOUTUBE_TIMEOUT_S=30
LIMITER_MAX_WAIT_S=20
# Socket timeout for Redis calls (limiter); a hung Redis fails closed after this
REDIS_TIMEOUT_S=2

# --- Retries / DLQ -------------------------------------------------------------------------------
# attempt budget per stage
RETRY_MAX_ATTEMPTS=5
# seconds; quick DLQ demo: 2,4,8
RETRY_DELAYS=10,30,90
OUTBOX_TIMEOUT_S=300
# how often the gateway sweeper looks for never-published jobs
OUTBOX_SWEEP_INTERVAL_S=30
# publisher-confirm wait before POST /jobs answers 503
BROKER_PUBLISH_TIMEOUT_S=5
# per-dependency timeout in GET /healthz
HEALTHCHECK_TIMEOUT_S=2

# --- Notion --------------------------------------------------------------------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://<ext-id>.chromiumapp.org/notion
# "Video Notes" page shared with the integration
NOTION_DEFAULT_PARENT_ID=
NOTION_API_VERSION=2026-03-11

# --- Security ------------------------------------------------------------------------------------
# Fernet key shared by gateway + workers (make fernet-key)
TOKEN_ENCRYPTION_KEY=

# --- Pipeline ------------------------------------------------------------------------------------
# Constraint A
MAX_VIDEO_SECONDS=1200
# The LLM picks between MIN_FRAMES and MAX_FRAMES moments per video
MIN_FRAMES=3
MAX_FRAMES=8
# Frames closer together than this (seconds) are deduplicated
FRAME_MIN_GAP_S=10
# EXTRACT_FRAMES: download height; grabs per pick (inside the same second); JPEG quality (2-31, lower is better)
FRAMES_VIDEO_HEIGHT=720
FRAME_BURST=3
FRAME_JPEG_QUALITY=3
# Blank frame: mean luma below FRAME_BLANK_LUMA (black is 16) or darkest-to-brightest spread below FRAME_FLAT_RANGE
FRAME_BLANK_LUMA=24
FRAME_FLAT_RANGE=24
# Per ffmpeg call
FFMPEG_TIMEOUT_S=60
# Frame-aware notes: candidate frames shown to the LLM (0 = captions only), from a small download
CANDIDATES_VIDEO_HEIGHT=480
CANDIDATE_MAX=36
CANDIDATE_MIN_GAP_S=15
CANDIDATE_SETTLE_S=1.5
CANDIDATE_JPEG_QUALITY=5
CANDIDATE_SNAP_S=2
SCENE_THRESHOLD=10
SCENE_DETECT_TIMEOUT_S=180
# low | medium | high: tokens per image sent to Gemini (medium reads slide text)
LLM_IMAGE_RESOLUTION=medium
TRANSCRIPT_LANGS=en,en-US,en-GB,hi
NOTES_LANGUAGE=English

# --- Speech-to-text (profile gpu) ----------------------------------------------------------------
STT_ENABLED=false
STT_URL=http://stt:9000
WHISPER_MODEL=small
WHISPER_DEVICE=cuda

# --- Runtime -------------------------------------------------------------------------------------
DATA_DIR=/data
FAKE_APIS=false
# fakes service URL, used only when FAKE_APIS=true (make up-fakes)
FAKES_URL=http://fakes:8090
LOG_LEVEL=INFO
# M1 stub stages: seconds each stage sleeps (removed in M2)
STUB_STAGE_SECONDS=3
