# Copy to .env and fill the blanks. Every variable is read by common/config.py (ARCHITECTURE §12).
# Never commit .env.

# --- Endpoints -----------------------------------------------------------------------------------
GATEWAY_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://vna:vna@postgres:5432/vna
RABBITMQ_URL=amqp://vna:vna@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0

# --- LLM -----------------------------------------------------------------------------------------
LLM_PROVIDER=gemini                    # gemini | ollama | fake
LLM_API_KEY=                           # Gemini key from Google AI Studio
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
LLM_CHUNK_CHARS=                       # unset -> 60000 for gemini, 12000 for ollama/fake
LLM_MAX_REPAIRS=1

# --- Rate limits (set BELOW the real limits shown for your project) ------------------------------
LLM_RPM=8
LLM_TPM=200000
NOTION_RPS=2.5
YOUTUBE_RPM=30
LIMITER_MAX_WAIT_S=20

# --- Retries / DLQ -------------------------------------------------------------------------------
RETRY_MAX_ATTEMPTS=5                   # attempt budget per stage
RETRY_DELAYS=10,30,90                  # seconds; quick DLQ demo: 2,4,8
OUTBOX_TIMEOUT_S=300

# --- Notion --------------------------------------------------------------------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://<ext-id>.chromiumapp.org/notion
NOTION_DEFAULT_PARENT_ID=              # "Video Notes" page shared with the integration
NOTION_API_VERSION=2026-03-11

# --- Security ------------------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=                  # Fernet key shared by gateway + workers (make fernet-key)

# --- Pipeline ------------------------------------------------------------------------------------
MAX_VIDEO_SECONDS=1200                 # Constraint A
MAX_FRAMES=8
TRANSCRIPT_LANGS=en,en-US,en-GB,hi
NOTES_LANGUAGE=English

# --- Speech-to-text (profile gpu) ----------------------------------------------------------------
STT_ENABLED=false
STT_URL=http://stt:9000
WHISPER_MODEL=small
WHISPER_DEVICE=cuda

# --- Runtime -------------------------------------------------------------------------------------
DATA_DIR=/data
FAKE_APIS=false
LOG_LEVEL=INFO
